generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  userId       Int           @unique @default(autoincrement())
  name         String
  phone        String?
  email        String        @unique
  password     String?
  walletMoney  Float         @default(0)
  userType     String        @default("Retail")
  signupType   String        @default("App/Admin")
  signupFrom   String        @default("Application")
  sessionsRevokedAt DateTime? // déconnexion forcée : jetons émis avant cette date refusés
  country      String?
  status       String        @default("Active")
  registeredAt DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Driver {
  id             String           @id @default(cuid())
  driverId       Int              @unique @default(autoincrement())
  name           String
  phone          String?
  email          String           @unique
  password       String?
  serviceArea    String?
  country        String?
  totalOrders    Int              @default(0)
  rating         Float            @default(0)
  earning        Float            @default(0)
  walletMoney    Float            @default(0)
  status         String           @default("Offline")
  approvalStatus String           @default("Approved")
  rejectionReason String?
  sessionsRevokedAt DateTime? // déconnexion forcée
  lastLocation   String?
  vehicleType    String?
  deviceToken    String?
  deviceType     String?
  appVersion     String?
  registeredAt   DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  orders         Order[]
  transactions   Transaction[]
  documents      DriverDocument[]
}

model DriverDocument {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type      String
  label     String
  fileUrl   String?
  expiresAt DateTime?
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String    @unique
  address     String?
  image       String?
  loginUrl    String? // obsolète (ancien lien prévisible), conservé pour compatibilité
  password    String? // espace marchand : hash bcrypt, défini par le marchand via son lien d'invitation
  inviteTokenHash String? @unique // SHA-256 du jeton d'invitation (le jeton en clair n'est jamais stocké)
  inviteExpiresAt DateTime?
  sessionsRevokedAt DateTime? // révocation d'accès : sessions marchand émises avant cette date refusées
  lastLoginAt DateTime?
  rating      Float     @default(5.0)
  walletMoney Float     @default(0)
  status      String    @default("Active")
  serviceArea String?
  segment     String    @default("PAPETERIE")
  totalOrders Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      Order[]
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  status      String   @default("Active")
  category    String?
  stock       Int      @default(0)
  barcode     String?  @unique
  /// Taux de TVA propre au produit (%). Vide : taux de sa catégorie, sinon taux par défaut (Comptabilité › Réglages).
  vatRate     Float?
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String   @id @default(cuid())
  orderId       String   @unique
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  userId        String?
  driverId      String?
  driver        Driver?  @relation(fields: [driverId], references: [id])
  total         Float
  subtotal      Float    @default(0)
  deliveryFee   Float    @default(500)
  status        String   @default("Pending")
  paymentMethod String   @default("Cash")
  paymentStatus String   @default("En attente")
  earning       Float    @default(0)
  items         Json
  address       String?
  invoiceId     String?
  notes         String?
  pickupOtp     String?
  deliveryOtp    String?
  signature     String? // Base64 signature
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id             String   @id @default(cuid())
  name           String
  segment        String   @default("Papeterie")
  parentCategory String?
  image          String?
  sequence       Int      @default(1)
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Float
  type      String    @default("Percentage")
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  status    String    @default("Active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Country {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  flag      String?
  phoneCode      String?
  currency       String?
  currencySymbol String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model ServiceArea {
  id          String   @id @default(cuid())
  name        String
  country     String
  lat         Float?
  lng         Float?
  radiusKm    Float?
  deliveryFee Float?
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model Vehicle {
  id        String   @id @default(cuid())
  name      String
  image     String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model SliderBanner {
  id        String   @id @default(cuid())
  title     String?
  image     String
  link      String?
  sequence  Int      @default(1)
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  target    String    @default("All")
  imageUrl  String?
  sentAt    DateTime?
  status    String    @default("Draft")
  createdAt DateTime  @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  driverId    String?
  driver      Driver?  @relation(fields: [driverId], references: [id])
  storeId     String?
  amount      Float
  type        String
  method      String   @default("Cash")
  description String?
  receiptNo   String?
  status      String   @default("Completed")
  createdAt   DateTime @default(now())
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("SubAdmin")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FareRule {
  id          String   @id @default(cuid())
  name        String
  baseFare    Float    @default(0)
  perKm       Float    @default(0)
  minFare     Float    @default(0)
  serviceArea String?
  vehicleType String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SurgePricing {
  id          String   @id @default(cuid())
  name        String
  multiplier  Float    @default(1.5)
  startTime   String
  endTime     String
  daysOfWeek  Json     @default("[]")
  serviceArea String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceTimeSlot {
  id         String   @id @default(cuid())
  label      String
  startTime  String
  endTime    String
  daysOfWeek Json     @default("[0,1,2,3,4,5,6]")
  maxOrders  Int?
  status     String   @default("Active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CancelReason {
  id        String   @id @default(cuid())
  reason    String
  userType  String   @default("All")
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model MapMarker {
  id          String   @id @default(cuid())
  label       String
  lat         Float
  lng         Float
  type        String   @default("store")
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
}

model Kit {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  level       String
  series      String?
  cycle       String
  description String?
  image       String?
  price       Float
  discountPct Float    @default(0)
  items       Json
  sequence    Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]")
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Stockage générique des modules du back-office sans table dédiée
// (FAQ, pages, types de service, unités, modèles d'e-mail...). Une ligne = un élément.
model AdminRecord {
  id         String   @id @default(cuid())
  collection String
  data       Json
  sequence   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection])
}

// Paramètres du back-office (formulaires « Enregistrer » de Configuration) : une clé = un formulaire.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Photos de produits televersees depuis le back-office / espace marchand (servies par /api/images/[id]).
model ProductImage {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  size      Int
  storeId   String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Comptabilité (SYSCOHADA révisé) : plan comptable, exercices, écritures en partie double
// ---------------------------------------------------------------------------

/// Compte du plan comptable (ex. 4111 Clients, 7011 Ventes de marchandises).
model AccAccount {
  code      String   @id
  label     String
  isActive  Boolean  @default(true)
  isSystem  Boolean  @default(false) /// compte utilisé par les écritures automatiques : non supprimable
  createdAt DateTime @default(now())
}

/// Exercice comptable (année civile en OHADA). Un exercice clôturé n'accepte plus d'écriture.
model AccFiscalYear {
  year      Int       @id
  startDate DateTime
  endDate   DateTime
  status    String    @default("Ouvert") /// Ouvert | Clôturé
  closedAt  DateTime?
  result    Int? /// résultat net constaté à la clôture (FCFA)
}

/// Écriture : en-tête (journal, date, pièce) + lignes équilibrées (total débit = total crédit).
model AccEntry {
  id         String    @id @default(cuid())
  journal    String /// VE ventes, AC achats, BQ banque, MM monnaie électronique, CA caisse, OD opérations diverses, AN à-nouveaux
  number     String    @unique /// ex. VE-2026-000123
  date       DateTime
  label      String
  reference  String? /// pièce justificative (n° de commande, facture fournisseur…)
  fiscalYear Int
  sourceType String? /// origine automatique (vente, encaissement, livreur…) ; vide = saisie manuelle
  sourceId   String?
  createdBy  String?
  createdAt  DateTime  @default(now())
  lines      AccLine[]

  @@unique([sourceType, sourceId])
  @@index([fiscalYear, journal, date])
}

/// Ligne d'écriture (montants entiers en FCFA).
model AccLine {
  id         String   @id @default(cuid())
  entryId    String
  entry      AccEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    String
  thirdParty String? /// tiers (client, fournisseur, livreur)
  label      String?
  debit      Int      @default(0)
  credit     Int      @default(0)
  vatRate    Float? /// taux de TVA de la base (déclaration de TVA)

  @@index([account])
  @@index([entryId])
}

/// Immobilisation amortie linéairement (dotation passée à la clôture de l'exercice).
model AccFixedAsset {
  id              String    @id @default(cuid())
  label           String
  account         String /// compte d'immobilisation (ex. 2441 Matériel de bureau)
  amortAccount    String /// compte d'amortissement (ex. 28441)
  acquisitionDate DateTime
  cost            Int /// valeur d'origine HT (FCFA)
  durationYears   Int
  status          String    @default("En service") /// En service | Cédée
  disposedAt      DateTime?
  createdAt       DateTime  @default(now())
}
