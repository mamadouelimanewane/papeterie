# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
.env*.local

papeterie-release.keystore
papeterie-release.keystore.b64

# secrets / artefacts
*.keystore
*.jks
*.b64
out.txt

# donnees commerciales (stock/prix) : ne pas publier
/data/
/tmp/out.json

# fiches d acces avec identifiants : ne jamais versionner
docs/acces/
*.docx
/audit-prive/
